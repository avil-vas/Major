<%- layout("/layouts/boilerplate") %>
<body>
    <h3>Editing your listing</h3>
    <form method="post" action="/listings/<%= list._id %>?_method=put" novalidate class="needs-validation" enctype="multipart/form-data">
         <div class="mb-3 mt-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" value="<%= list.title %>" class="form-control" required>
        </div>
         <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required><%= list.description %></textarea>
        </div>
        <div class="mb-3">
          Original Image <br>
            <% if (listingImage) { %>
                <img src="<%= listingImage %>" alt="">
            <% } else { %>
                <img src="<%= listing.image.url %>" alt="" style="height: 200px; width: auto;">
            <% } %>

        </div>
         <div class="mb-3">
            <label for="image" class="form-label" class="form-label">Upload new Image </label>
      
        <input type="file" name="listing[image]" class="form-control" >
        </div>

        <div class="row">
             <div class="mb-3 col-md-4">
            <label for="price" class="form-label" class="form-label">Price</label>
                   <input type="number" name="listing[price]" value="<%= list.price%>" class="form-control" required>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label" class="form-label">Country</label>
               <input type="text" name="listing[country]" value="<%= list.country %>" class="form-control" required>
        </div>
        </div>
       
         <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" value="<%= list.location %>"
            class="form-control" required>
        </div>
        <button class="btn edit-btn mt-3">Edit</button>
        <br>
        <br>
    </form>
</body>

